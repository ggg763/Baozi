<view class="page">
  <view class="page-title">我的</view>

  <!-- 设备状态卡片 -->
  <view class="card device">
    <view class="device-name">包子</view>
    <view class="device-status">
      <view class="dot {{online ? 'on' : 'off'}}"></view>
      <text class="status-text">{{online ? '在线' : '离线'}} · 固件 1.0.3</text>
    </view>
  </view>

  <!-- 功能列表 -->
  <view class="card menu">
    <view class="menu-item">
      <text>提醒总开关</text>
      <switch checked="{{remindOn}}" color="#BA7517" bindchange="onRemindToggle" />
    </view>
    <view class="menu-item" bindtap="showHelp">
      <text>语音指令帮助</text>
      <text class="arrow">›</text>
    </view>
    <view class="menu-item" bindtap="bindDevice">
      <text>绑定设备</text>
      <text class="arrow">›</text>
    </view>
  </view>

  <view class="card about">
    <text class="about-text">包子 BaoZi · 桌面学习陪伴机器人</text>
    <text class="about-text sub">不依赖手机，专注陪伴你的学习与生活</text>
  </view>
</view>
